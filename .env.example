# Copy to `.env` before running the app:
#   macOS / Linux:  cp .env.example .env
#   Windows (PS):   Copy-Item .env.example .env
#
# `.env` is gitignored, so a fresh clone has NO env file and the frontend falls
# back to "offline preview" mode — the advisor echoes your message instead of
# answering. If the chat looks alive but never gives a real answer, this is why.

# --- Frontend ---------------------------------------------------------------
# The advisor endpoint the React app POSTs to. Unset => offline echo mode.
#
# 127.0.0.1, not localhost, on purpose: Windows resolves "localhost" to the IPv6
# ::1 first, while uvicorn listens on IPv4. Pointing at localhost there can stall
# instead of failing, which shows up as a chat stuck on "Checking the data…".
VITE_AGENT_URL=http://127.0.0.1:8000/api/v1/analyze-major

# Optional. Only needed when the backend sets ADVISOR_API_KEY (see below).
# This ships inside the browser bundle, so it is NOT a secret — it raises the bar
# against casual abuse of an endpoint that spends money per request.
# VITE_ADVISOR_API_KEY=

# --- Google Cloud / Vertex --------------------------------------------------
# Auth is ADC only — no keys live in this file. Sign in once with:
#   gcloud auth application-default login
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=sprinternship-sea-2026
GOOGLE_CLOUD_LOCATION=global

# --- BigQuery ---------------------------------------------------------------
BQ_PROJECT_ID=sprinternship-sea-2026
BQ_DATASET=majors
# ADVISOR_USE_BIGQUERY=1              # 0 disables SQL escalation entirely
# ADVISOR_BQ_MAX_BYTES_BILLED=268435456

# --- Backend tuning (all optional) ------------------------------------------
# ADVISOR_HOST=127.0.0.1              # read by scripts/dev.mjs
# ADVISOR_PORT=8000                   # read by scripts/dev.mjs
# ADVISOR_TIMEOUT_S=30
# ADVISOR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ADVISOR_API_KEY=                    # set in any deployment reachable publicly
# ADVISOR_RATE_LIMIT_PER_MIN=0        # 0 disables
